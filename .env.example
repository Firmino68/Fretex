# ============================================================
# FRETEX - variáveis de ambiente
# Copia este ficheiro para ".env" e preenche os valores.
# O ficheiro ".env" NUNCA deve ser enviado para o Git.
# ============================================================

# Porta do servidor (o frontend e a API são servidos aqui)
PORT=3000

# development | production
NODE_ENV=development

# Ligação ao MongoDB
#   Local:  mongodb://127.0.0.1:27017/fretex_db
#   Atlas:  mongodb+srv://<utilizador>:<password>@<cluster>.mongodb.net/fretex_db
#           (codifica em URL os caracteres especiais da password)
MONGODB_URI=mongodb://127.0.0.1:27017/fretex_db

# Chave para assinar os tokens JWT. OBRIGATÓRIA, mínimo 32 caracteres.
# Gera uma chave aleatória com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=GERA_UMA_CHAVE_ALEATORIA_E_COLA_AQUI

# (Opcional) Duração do token. Por defeito: 7d
# JWT_EXPIRES_IN=7d

# (Opcional) Só necessário se o frontend for servido de OUTRA origem
# (ex.: Live Server). Lista separada por vírgulas. Deixa vazio em uso normal.
# CORS_ORIGINS=http://127.0.0.1:5500
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=exemplo@gmail.com
SMTP_PASS=COLOCA_AQUI_A_PALAVRA_PASSE_DE_APLICACAO